<?xml version="1.0" encoding="utf-8"?>
<!-- El vigía de Shorts, Reels y Estados (Vigia.java). Recibe los eventos de
     todas las apps para saber cuándo se sale de una vigilada y quitar la tapa,
     pero solo mira la pantalla de las vigiladas (YouTube, Instagram, WhatsApp,
     LinkedIn). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewClicked|typeViewSelected"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="0"
    android:description="@string/vigia_descripcion" />
